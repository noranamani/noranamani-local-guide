{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "offer_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "municipality": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "valid_from": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "string",
                "format": "date-time"
              }
            ]
          },
          "valid_until": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "string",
                "format": "date-time"
              }
            ]
          },
          "eligibility": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "maxLength": 1000
          },
          "last_verified_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "offer_id",
          "title",
          "municipality",
          "valid_from",
          "valid_until",
          "eligibility",
          "source_url",
          "last_verified_at"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "items"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
