{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "title": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 160
    },
    "featured_event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "title",
    "featured_event_ids"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
