{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "areas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "prefecture": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "priority": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "name",
          "prefecture",
          "priority"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "areas"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
