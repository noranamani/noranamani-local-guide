{
  "schema_version": 1,
  "provider": "rakuten_travel",
  "enabled": false,
  "api_fetch_enabled": false,
  "affiliate_publication_enabled": false,
  "approvals": {
    "travel_api_access_confirmed": false,
    "local_guide_registered_as_affiliate_site": true,
